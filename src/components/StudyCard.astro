---
// 스터디 목록의 글 카드. 프로젝트의 그리드 카드와 달리 세로 1열 행 카드다(2열이면 제목·요약이 잘린다 — PROGRESS.md 5-7)
// - 시안: design/StudyLog.dc.html(데스크톱) · MobileStudyLog · TabletStudyLog
// - 모바일·태블릿은 세로 쌓기(날짜 · 읽는 시간을 점으로 잇는다), 데스크톱은 왼쪽 글 / 오른쪽 날짜·읽는 시간 2단
// - href가 있으면 카드 전체가 링크(글 상세), 없으면 링크 없는 article로 그린다(동작 없는 링크를 만들지 않는다)
import type { CollectionEntry } from 'astro:content';
import { formatDay } from '../lib/date';
import { readingTime } from '../lib/readingTime';

interface Props {
	post: CollectionEntry<'study'>;
	href?: string;
}

const { post, href } = Astro.props;
const { title, summary, category, pubDate } = post.data;
const Tag = href ? 'a' : 'article';
---

<Tag class="card" href={href}>
	<div class="text">
		<span class="tag">{category}</span>
		<span class="title">{title}</span>
		<span class="summary">{summary}</span>
	</div>
	<div class="meta">
		<time datetime={pubDate.toISOString().slice(0, 10)}>{formatDay(pubDate)}</time>
		<span class="dot" aria-hidden="true"></span>
		<span class="read">{readingTime(post.body)}</span>
	</div>
</Tag>

<style>
	.card {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px;
		border: 1px solid var(--win-divider);
		border-radius: 16px;
		background: var(--win-card);
		transition:
			border-color var(--dur-fast) var(--ease-out),
			transform var(--dur-press) var(--ease-out);
	}

	a.card:active {
		border-color: var(--win-accent);
		transform: scale(0.985);
	}

	a.card:focus-visible {
		outline: 2px solid var(--win-accent);
		outline-offset: 2px;
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.tag {
		align-self: flex-start;
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--win-tag-bg);
		color: var(--win-tag-ink);
		font-size: 11.5px;
		font-weight: 700;
	}

	.title {
		color: var(--win-ink-strong);
		font-size: 16.5px;
		font-weight: 700;
		line-height: 1.45;
		word-break: keep-all;
	}

	/* 요약은 두 줄까지만(좁은 폭에서 카드 높이가 들쭉날쭉해진다) */
	.summary {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--win-ink-muted);
		font-size: 14px;
		line-height: 1.6;
		word-break: keep-all;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 8px;
		color: var(--win-ink-sub);
		font-size: 12.5px;
		white-space: nowrap;
	}

	.dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--win-dot);
	}

	@media (min-width: 744px) {
		.card {
			gap: 10px;
			padding: 24px 26px;
			border-radius: 18px;
		}

		a.card:active {
			transform: scale(0.99);
		}

		.text {
			gap: 10px;
		}

		.tag {
			padding: 4px 11px;
			font-size: 12px;
		}

		.title {
			font-size: 19px;
		}

		.summary {
			font-size: 15.5px;
			line-height: 1.7;
		}

		.meta {
			font-size: 13px;
		}
	}

	/* 데스크톱: 왼쪽 글 / 오른쪽 날짜·읽는 시간 */
	@media (min-width: 1180px) {
		.card {
			flex-direction: row;
			align-items: flex-start;
			justify-content: space-between;
			gap: 40px;
			padding: 28px 32px;
		}

		a.card:hover {
			border-color: var(--win-accent);
		}

		a.card:active {
			transform: none;
		}

		.tag {
			font-size: 12.5px;
			padding: 5px 12px;
		}

		.summary {
			display: block;
			max-width: 800px;
			font-size: 14.5px;
			line-height: 1.65;
		}

		.meta {
			flex-direction: column;
			align-items: flex-end;
			gap: 6px;
			font-size: 14px;
		}

		.dot {
			display: none;
		}

		.read {
			font-size: 13px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}
	}
</style>
