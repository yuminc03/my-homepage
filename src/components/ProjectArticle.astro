---
// 프로젝트 상세 본문: Markdown(## 소개 / ## 기술적으로 고민한 점 / ## 배운 점) 사이에 주요 기능을 끼워 넣는다
// - 시안 순서: 소개 → 주요 기능 → 기술적으로 고민한 점 → 배운 점. 주요 기능은 프런트매터 데이터라 본문 Markdown에 없다
// - 기본 slot(<Content />)과 features slot을 HTML 문자열로 렌더링한 뒤, 본문을 ## 단위로 나눠 첫 섹션 뒤에 주요 기능을 넣는다(src/lib/sections.ts)
// - Markdown이 만든 요소에는 스코프 속성이 없어 스타일은 .prose 아래 :global로 준다. 끼워 넣은 주요 기능(자기 스타일이 있음)에 닿지 않게 .doc-lead·.doc-section 안으로 한정한다
import { splitSections } from '../lib/sections';

const body = await Astro.slots.render('default');
const features = Astro.slots.has('features') ? await Astro.slots.render('features') : '';
const { lead, sections } = splitSections(body);
const [first = '', ...rest] = sections;
const html = [lead && `<div class="doc-lead">${lead}</div>`, first, features, ...rest].join('');
---

<div class="prose" set:html={html} />

<style>
	.prose {
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	/* 문단 사이 1em. 제목 바로 다음 요소는 제목의 margin-bottom만 쓴다 */
	.prose :global(:is(.doc-lead, .doc-section) > :not(h2) + *) {
		margin-top: 1em;
	}

	.prose :global(.doc-section > h2) {
		margin: 0 0 12px;
		color: var(--win-ink-strong);
		font-size: 20px;
		font-weight: 800;
		line-height: 1.4;
		word-break: keep-all;
	}

	.prose :global(:is(.doc-lead, .doc-section) :is(p, li)) {
		margin: 0;
		color: var(--win-ink);
		font-size: 16px;
		line-height: 1.8;
		word-break: keep-all;
	}

	.prose :global(:is(.doc-lead, .doc-section) :is(ul, ol)) {
		margin: 0;
		padding-left: 1.3em;
	}

	.prose :global(:is(.doc-lead, .doc-section) li + li) {
		margin-top: 0.4em;
	}

	.prose :global(:is(.doc-lead, .doc-section) strong) {
		color: var(--win-ink-strong);
		font-weight: 700;
	}

	.prose :global(:is(.doc-lead, .doc-section) a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.prose :global(:is(.doc-lead, .doc-section) img) {
		display: block;
		border-radius: 14px;
	}

	.prose :global(:is(.doc-lead, .doc-section) :not(pre) > code) {
		padding: 2px 6px;
		border-radius: 6px;
		background: var(--win-tag-bg);
		color: var(--win-tag-ink);
		font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 0.88em;
	}

	/* 코드 블록 색은 구문 강조 테마가 정한다(테마와 무관한 고정색) */
	.prose :global(:is(.doc-lead, .doc-section) pre) {
		overflow-x: auto;
		padding: 16px 18px;
		border: 1px solid var(--win-divider);
		border-radius: 12px;
		font-family: ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;
		font-size: 13px;
		line-height: 22px;
	}

	.prose :global(:is(.doc-lead, .doc-section) blockquote) {
		margin: 0;
		padding-left: 16px;
		border-left: 3px solid var(--win-chip-line);
	}

	/* ### 카드: "기술적으로 고민한 점"의 문제 하나 = 카드 하나 */
	.prose :global(.doc-cards) {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	/* 카드가 제목 바로 아래면 제목 아래 간격을 조금 더 벌린다(시안: 글 12px · 카드 16px) */
	.prose :global(.doc-section > h2 + .doc-cards) {
		margin-top: 4px;
	}

	.prose :global(.doc-card) {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 20px;
		border: 1px solid var(--win-divider);
		border-radius: 16px;
		background: var(--win-card);
	}

	.prose :global(.doc-card > h3) {
		margin: 0;
		color: var(--win-ink-strong);
		font-size: 16.5px;
		font-weight: 700;
		line-height: 1.45;
		word-break: keep-all;
	}

	.prose :global(.doc-card :is(p, li)) {
		color: var(--win-ink-2);
		font-size: 15px;
		line-height: 1.75;
	}

	@media (min-width: 744px) {
		.prose {
			gap: 48px;
		}

		.prose :global(.doc-section > h2) {
			margin-bottom: 14px;
			font-size: 22px;
		}

		.prose :global(:is(.doc-lead, .doc-section) :is(p, li)) {
			font-size: 17px;
		}

		.prose :global(.doc-cards) {
			gap: 12px;
		}

		.prose :global(.doc-section > h2 + .doc-cards) {
			margin-top: 6px;
		}

		.prose :global(.doc-card) {
			gap: 9px;
			padding: 22px 24px;
		}

		.prose :global(.doc-card > h3) {
			font-size: 17px;
		}

		.prose :global(.doc-card :is(p, li)) {
			font-size: 15.5px;
			line-height: 1.8;
		}
	}

	@media (min-width: 1180px) {
		.prose {
			gap: 56px;
		}

		.prose :global(.doc-section > h2) {
			margin-bottom: 16px;
			font-size: 24px;
		}

		.prose :global(:is(.doc-lead, .doc-section) :is(p, li)) {
			line-height: 1.85;
		}

		.prose :global(.doc-section > h2 + .doc-cards) {
			margin-top: 8px;
		}

		.prose :global(.doc-card) {
			gap: 10px;
			padding: 24px 28px;
		}

		.prose :global(.doc-card > h3) {
			font-size: 18px;
		}

		.prose :global(.doc-card :is(p, li)) {
			font-size: 16px;
			line-height: 1.8;
		}
	}
</style>
