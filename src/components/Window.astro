---
// 앱 창
// - 데스크톱(≥1180px): 메뉴바 아래 가운데 떠 있는 창(최대 1240px). 타이틀 바 44px · 창 점 · 제목 · ✕(28px)
// - 모바일·태블릿: 아래에서 올라와 화면을 채운 시트. 위 12/16px 틈으로 바탕이 비친다. 타이틀 바 52/56px(스크롤해도 고정) · ✕(44px)
// - ✕는 창을 닫고 홈으로 간다. 창 점은 장식(기능 없음, 신호등 색 쓰지 않음)
import { withBase } from '../lib/url';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<div class="window-area">
	<section class="window" aria-label={title}>
		<header class="titlebar">
			<span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
			<span class="title">{title}</span>
			<a class="close" href={withBase('/')} aria-label="창 닫고 홈으로">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</a>
		</header>
		<div class="body">
			<slot />
		</div>
	</section>
</div>

<style>
	.window-area {
		position: relative;
		z-index: 2;
		padding-top: 12px;
	}

	/* overflow: clip — 모서리는 자르되 스크롤 컨테이너를 만들지 않아 타이틀 바의 sticky가 유지된다 */
	.window {
		min-height: calc(100dvh - 12px);
		overflow: clip;
		border: 1px solid var(--win-line);
		border-bottom: 0;
		border-radius: 22px 22px 0 0;
		background: var(--win-bg);
		box-shadow: 0 -10px 40px var(--win-shadow);
		color: var(--win-ink);
	}

	.titlebar {
		position: sticky;
		top: 0;
		z-index: 5;
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr) 80px;
		align-items: center;
		height: 52px;
		padding: 0 6px 0 16px;
		border-bottom: 1px solid var(--win-bar-line);
		background: var(--win-bar);
	}

	.dots {
		display: flex;
		gap: 6px;
	}

	.dots span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--win-ctrl-a);
	}

	.dots span:nth-child(2) {
		background: var(--win-ctrl-b);
	}

	.dots span:nth-child(3) {
		background: var(--win-ctrl-c);
	}

	.title {
		overflow: hidden;
		color: var(--win-title);
		font-size: 14px;
		font-weight: 600;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.close,
	.close:hover {
		display: flex;
		align-items: center;
		justify-content: center;
		justify-self: end;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		color: var(--win-icon);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.close svg {
		width: 18px;
		height: 18px;
	}

	.close:active {
		background: var(--win-press);
	}

	.close:focus-visible {
		outline: 2px solid var(--win-accent);
		outline-offset: -2px;
	}

	.body {
		padding: 26px 20px 150px;
	}

	@media (min-width: 744px) {
		.window-area {
			padding-top: 16px;
		}

		.window {
			min-height: calc(100dvh - 16px);
			border-radius: 26px 26px 0 0;
			box-shadow: 0 -12px 48px var(--win-shadow);
		}

		.titlebar {
			grid-template-columns: 100px minmax(0, 1fr) 100px;
			height: 56px;
			padding: 0 10px 0 22px;
		}

		.dots {
			gap: 7px;
		}

		.dots span {
			width: 10px;
			height: 10px;
		}

		.title {
			font-size: 15px;
		}

		.close svg {
			width: 20px;
			height: 20px;
		}

		.body {
			padding: 34px 36px 170px;
		}
	}

	@media (min-width: 1180px) {
		.window-area {
			padding: 56px 40px 140px;
		}

		.window {
			max-width: 1240px;
			min-height: 0;
			margin: 0 auto;
			border-bottom: 1px solid var(--win-line);
			border-radius: 16px;
			box-shadow: 0 44px 96px var(--win-shadow);
		}

		.titlebar {
			position: relative;
			display: flex;
			justify-content: center;
			height: 44px;
			padding: 0 44px;
		}

		.dots {
			position: absolute;
			left: 16px;
			gap: 8px;
		}

		.dots span {
			width: 11px;
			height: 11px;
		}

		.title {
			font-size: 13px;
		}

		.close,
		.close:hover {
			position: absolute;
			top: 8px;
			right: 8px;
			width: 28px;
			height: 28px;
			border-radius: 8px;
		}

		.close svg {
			width: 15px;
			height: 15px;
		}

		.close:hover {
			background: var(--win-press);
			color: var(--win-ink-strong);
		}

		.body {
			padding: 48px;
		}
	}
</style>
