---
// 앱 창
// - 데스크톱(≥1180px): 메뉴바 아래 가운데 떠 있는 창(최대 1240px). 타이틀 바 44px · 창 점 · 제목 · ✕(28px)
// - 모바일·태블릿: 아래에서 올라와 화면을 채운 시트. 위 12/16px 틈으로 바탕이 비친다. 타이틀 바 52/56px(스크롤해도 고정) · ✕(44px)
// - ✕는 창을 닫고 홈으로 간다. 창 점은 장식(기능 없음, 신호등 색 쓰지 않음)
// - back이 있으면(상세 화면) 모바일·태블릿 타이틀 바 왼쪽의 창 점 자리에 ‹ 목록 링크를 둔다
//   데스크톱은 창 점을 그대로 두고, 목록 링크는 페이지가 본문 읽기 폭 맨 위에 둔다(시안)
// - 뒤로 가는 링크에는 data-back-link를 붙인다(아래 스크립트가 목록에서 고른 분류를 도로 붙여 준다).
//   페이지가 따로 두는 데스크톱 ‹ 링크에도 같은 속성을 붙인다
import WindowDots from './WindowDots.astro';
import { withBase } from '../lib/url';

interface Props {
	title: string;
	back?: {
		href: string;
		/** 스크린 리더용 링크 이름(예: 프로젝트 목록으로) */
		label: string;
	};
}

const { title, back } = Astro.props;
---

<div class="window-area">
	<section class="window" aria-label={title}>
		<header class:list={['titlebar', { 'has-back': back }]}>
			<span class="dots"><WindowDots /></span>
			{
				back && (
					<a class="back" href={back.href} aria-label={back.label} data-back-link>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M15 5l-7 7 7 7" />
						</svg>
					</a>
				)
			}
			<span class="title">{title}</span>
			<a class="close" href={withBase('/')} aria-label="창 닫고 홈으로">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</a>
		</header>
		<div class="body">
			<slot />
		</div>
	</section>
</div>

<script>
	// 목록에서 고른 분류를 기억했다가(FilterChips가 sessionStorage에 남긴다) ‹ 뒤로 링크에 도로 붙인다.
	// 브라우저 뒤로 가기는 주소의 ?category=로 이미 유지되지만, 창 안의 ‹ 링크는 정적 주소라 전체 목록으로 가 버린다
	// 스크립트가 없거나 저장을 막아 둔 브라우저에서는 링크가 그대로 전체 목록으로 간다
	for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-back-link]')) {
		try {
			const url = new URL(link.href);
			const category = sessionStorage.getItem(`filter:${url.pathname}`);
			if (!category) continue;
			url.searchParams.set('category', category);
			link.href = url.toString();
		} catch {
			// 저장소를 쓸 수 없는 브라우저(시크릿 모드 등)
		}
	}
</script>

<style>
	.window-area {
		position: relative;
		z-index: 2;
		padding-top: 12px;
	}

	/* overflow: clip — 모서리는 자르되 스크롤 컨테이너를 만들지 않아 타이틀 바의 sticky가 유지된다 */
	.window {
		min-height: calc(100dvh - 12px);
		overflow: clip;
		border: 1px solid var(--win-line);
		border-bottom: 0;
		border-radius: 22px 22px 0 0;
		background: var(--win-bg);
		box-shadow: 0 -10px 40px var(--win-shadow);
		color: var(--win-ink);
	}

	.titlebar {
		position: sticky;
		top: 0;
		z-index: 5;
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr) 80px;
		align-items: center;
		height: 52px;
		padding: 0 6px 0 16px;
		border-bottom: 1px solid var(--win-bar-line);
		background: var(--win-bar);
	}

	/* 창 점 크기·간격은 WindowDots가 읽는 변수로 정한다 */
	.dots {
		--dot-size: 9px;
		--dot-gap: 6px;
		display: flex;
	}

	/* 뒤로: 창 점 자리(첫 칸)에 44px 누름 영역. 창 점은 숨긴다 */
	.titlebar.has-back {
		padding-left: 6px;
	}

	.titlebar.has-back .dots {
		display: none;
	}

	.back,
	.back:hover {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		color: var(--win-accent);
		transition: background-color var(--dur-fast) var(--ease-out);
	}

	.back svg {
		width: 20px;
		height: 20px;
	}

	.back:active {
		background: var(--win-press);
	}

	.back:focus-visible {
		outline: 2px solid var(--win-accent);
		outline-offset: -2px;
	}

	.title {
		overflow: hidden;
		color: var(--win-title);
		font-size: 14px;
		font-weight: 600;
		text-align: center;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.close,
	.close:hover {
		display: flex;
		align-items: center;
		justify-content: center;
		justify-self: end;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		color: var(--win-icon);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.close svg {
		width: 18px;
		height: 18px;
	}

	.close:active {
		background: var(--win-press);
	}

	.close:focus-visible {
		outline: 2px solid var(--win-accent);
		outline-offset: -2px;
	}

	.body {
		padding: 26px 20px 150px;
	}

	@media (min-width: 744px) {
		.window-area {
			padding-top: 16px;
		}

		.window {
			min-height: calc(100dvh - 16px);
			border-radius: 26px 26px 0 0;
			box-shadow: 0 -12px 48px var(--win-shadow);
		}

		.titlebar {
			grid-template-columns: 100px minmax(0, 1fr) 100px;
			height: 56px;
			padding: 0 10px 0 22px;
		}

		.dots {
			--dot-size: 10px;
			--dot-gap: 7px;
		}

		.titlebar.has-back {
			padding-left: 10px;
		}

		.back svg {
			width: 22px;
			height: 22px;
		}

		.title {
			font-size: 15px;
		}

		.close svg {
			width: 20px;
			height: 20px;
		}

		.body {
			padding: 34px 36px 170px;
		}
	}

	@media (min-width: 1180px) {
		.window-area {
			padding: 56px 40px 140px;
		}

		.window {
			max-width: 1240px;
			min-height: 0;
			margin: 0 auto;
			border-bottom: 1px solid var(--win-line);
			border-radius: 16px;
			box-shadow: 0 44px 96px var(--win-shadow);
		}

		.titlebar {
			position: relative;
			display: flex;
			justify-content: center;
			height: 44px;
			padding: 0 44px;
		}

		.dots,
		.titlebar.has-back .dots {
			--dot-size: 11px;
			--dot-gap: 8px;
			display: flex;
			position: absolute;
			left: 16px;
		}

		/* 데스크톱은 목록 링크를 본문에 두므로 타이틀 바에서는 뺀다 */
		.titlebar.has-back {
			padding-left: 44px;
		}

		.back,
		.back:hover {
			display: none;
		}

		.title {
			font-size: 13px;
		}

		.close,
		.close:hover {
			position: absolute;
			top: 8px;
			right: 8px;
			width: 28px;
			height: 28px;
			border-radius: 8px;
		}

		.close svg {
			width: 15px;
			height: 15px;
		}

		.close:hover {
			background: var(--win-press);
			color: var(--win-ink-strong);
		}

		.body {
			padding: 48px;
		}
	}
</style>
