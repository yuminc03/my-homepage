---
// 사이트 공통 셸: 블러 글로우 바탕 · 메뉴바 · 본문(<main>) · Dock
// - active: 메뉴바 활성 표시와 Dock 실행 점을 붙일 앱
// - surface: desk = 홈(바탕 위, 모바일·태블릿에도 메뉴바 표시) / window = 창이 열린 화면(목록·상세)
// - dockHidden: Dock을 숨긴 채 시작한다(상세 화면)
// - title: 상세 화면의 글 제목만 넘긴다. 탭 제목은 "글 제목 · 앱 라벨 · 사이트 이름"으로 여기서 조립한다(홈은 사이트 이름만)
//   공유 카드(OG)는 title이 있으면 글 한 편(article)으로 보고 제목에 글 제목만 쓴다. 사이트 이름은 og:site_name이 따로 보여 준다
// - shareImage: 공유 카드 썸네일(세미나 상세는 표지 사진). 없으면 사이트 대표 이미지
// 페이지 전환(PageTransitions): 메뉴바·Dock은 각자 transition:name을 가져(MenuBar·Dock 안에 있다) 화면 전환과 따로 논다.
// 이름이 있는 요소는 본문 스냅샷에서 빠지므로 본문이 옆으로 밀려도 제자리에 남는다.
// 글로우는 일부러 이름을 주지 않는다 — 바탕까지 함께 밀려야 "화면 한 장이 통째로 넘어가는" OS 메타포가 된다
import BaseLayout, { type ShareImage } from './BaseLayout.astro';
import MenuBar from '../components/MenuBar.astro';
import Dock from '../components/Dock.astro';
import SearchPanel from '../components/SearchPanel.astro';
import { SITE_NAME, getApp, type AppId } from '../data/apps';

interface Props {
	active: AppId;
	surface?: 'desk' | 'window';
	title?: string;
	description?: string;
	dockHidden?: boolean;
	shareImage?: ShareImage;
}

const { active, surface = 'window', title, description, dockHidden = false, shareImage } = Astro.props;
const app = getApp(active);
const pageTitle = [title, active === 'home' ? undefined : app.label, SITE_NAME].filter(Boolean).join(' · ');
---

<BaseLayout
	title={pageTitle}
	description={description ?? app.description}
	shareTitle={title ?? pageTitle}
	shareType={title ? 'article' : 'website'}
	shareImage={shareImage}
>
	<div class="glow" aria-hidden="true">
		<span class="glow-a"></span>
		<span class="glow-b"></span>
		<span class="glow-c"></span>
	</div>
	<MenuBar active={active} showOnTouch={surface === 'desk'} />
	<main class="site-main">
		<slot />
	</main>
	<Dock active={active} surface={surface} startHidden={dockHidden} />
	<SearchPanel />
</BaseLayout>

<style>
	/* 바탕 블러 글로우: 화면에 고정된 장식 층. 스크롤·클릭에 관여하지 않는다 */
	.glow {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.glow span {
		position: absolute;
		border-radius: 50%;
	}

	.glow-a {
		top: -160px;
		left: -140px;
		width: 420px;
		height: 420px;
		background: var(--glow-a);
		filter: blur(90px);
		opacity: 0.34;
	}

	.glow-b {
		top: 420px;
		right: -180px;
		width: 380px;
		height: 380px;
		background: var(--glow-b);
		filter: blur(100px);
		opacity: 0.28;
	}

	.glow-c {
		bottom: -120px;
		left: -80px;
		width: 340px;
		height: 340px;
		background: var(--glow-c);
		filter: blur(100px);
		opacity: 0.22;
	}

	.site-main {
		position: relative;
		z-index: 1;
	}

	@media (min-width: 744px) {
		.glow-a {
			top: -200px;
			left: -160px;
			width: 560px;
			height: 560px;
			filter: blur(120px);
		}
	}

	@media (min-width: 1180px) {
		.glow-a {
			top: -240px;
			left: -180px;
			width: 760px;
			height: 760px;
			filter: blur(160px);
		}

		.glow-b {
			top: 120px;
			right: -240px;
			width: 680px;
			height: 680px;
			filter: blur(180px);
			opacity: 0.3;
		}

		.glow-c {
			bottom: -260px;
			left: 280px;
			width: 620px;
			height: 620px;
			filter: blur(190px);
		}
	}
</style>
