---
// 모든 페이지가 공유하는 문서 뼈대: 메타 태그, 글꼴, 전역 토큰·기본 스타일
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Chu Yumin',
	description = 'iOS 개발자 Chu Yumin의 프로젝트·스터디·세미나 기록',
} = Astro.props;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<script is:inline>
			// 첫 화면을 그리기 전에 저장된 테마를 적용한다(깜빡임 방지). 저장값이 없으면 CSS가 시스템 설정을 따른다
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {}
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700;800;900&display=swap"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
